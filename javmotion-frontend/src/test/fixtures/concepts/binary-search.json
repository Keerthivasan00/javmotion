  "key": "array",
  "title": "Binary search for 9",
  "code": "public class BinarySearch {\n    public static void main(String[] args) {\n        int[] arr = {1, 3, 4, 7, 9, 11};\n        int target = 9;\n        int low = 0;\n        int high = arr.length - 1;\n        int found = -1;\n        while (low <= high) {\n            int mid = (low + high) / 2;\n            if (arr[mid] == target) {\n                found = mid;\n                break;\n            } else if (arr[mid] < target) {\n                low = mid + 1;\n            } else {\n                high = mid - 1;\n            }\n        }\n        System.out.println(found);\n    }\n}\n",
